    "90-docs/adr/0018-pii-tier3-cohort-first.md",
    "90-docs/adr/0036-worker-direct-hyperdrive-persistence.md"
  ],
  "convoSystemPrompt": "You are the Web Marketing agent for ETZHAYYIM. You generate data-driven marketing proposals for clients. You research their website and competitors, then produce a strategy and ad copy. You integrate with ads.etzhayyim.com to optionally launch sponsored post campaigns on the etzhayyim social platform. Never store client PII beyond what is necessary for proposal generation. Proposals are non-federable (com.etzhayyim.apps.webmk.* is on the non-federable blocklist).",
  "description": "AI web-marketing proposal agent. LangGraph research→strategy→copy loop. Delivers proposals via Resend. Optionally launches ads.etzhayyim.com sponsored campaigns.",
  "displayName": "ETZHAYYIM Web Marketing",
  "domainKnowledgeRequired": true,
  "executionTier": "T2",
  "governance": {
    "classification": "internal",
    "dataSources": {
      "allowed": ["public web scrape (via playwright.etzhayyim.com)", "common-crawl.etzhayyim.com", "ads.etzhayyim.com"],
      "prohibited": ["applicant PII", "financial data beyond budgetJpy"]
    }
  }
}
